{
  "name": "itplace-user-front-nextjs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 5173",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 5173",
    "lint": "eslint . --config eslint.config.js",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs scripts/map-preview-compact.test.mjs",
    "test:production": "node scripts/verify-production.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:production",
    "update:partner-catalog": "node scripts/update-partner-catalog.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "build:workers": "opennextjs-cloudflare build",
    "preview:workers": "opennextjs-cloudflare preview --ip 127.0.0.1 --port 8787",
    "deploy:workers": "opennextjs-cloudflare deploy",
    "test:workers": "node scripts/verify-production.mjs --workers",
    "verify:workers": "npm run lint && npm run typecheck && npm test && npm run build:workers && npm run test:workers",
    "upload:workers": "opennextjs-cloudflare upload"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@reduxjs/toolkit": "^2.8.2",
    "axios": "^1.10.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "gsap": "^3.13.0",
    "lodash": "^4.17.21",
    "next": "^16.3.5",
    "react": "^19.2.8",
    "react-datepicker": "^8.4.0",
    "react-dom": "^19.2.8",
    "react-google-recaptcha": "^3.1.0",
    "react-icons": "^5.5.0",
    "react-redux": "^9.2.0",
    "react-toastify": "^11.0.5",
    "redux-persist": "^6.0.0",
    "swiper": "^12.2.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.25",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/react-google-recaptcha": "^2.1.9",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.21.0",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.5",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "wrangler": "^4.135.0"
  }
}
